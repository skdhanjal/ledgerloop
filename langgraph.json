{
    "python_version": "3.12",
    "dependencies": ["."],
    "graphs": {
      "ledgerloop": "./graph/app.py:graph"
    },
    "env": ".env",
    "store": {
      "index": {
        "embed": "./graph/store.py:embed_texts",
        "dims": 384,
        "fields": ["text"]
      }
    },
    "dockerfile_lines": [
      "RUN pip install --no-cache-dir fastembed",
      "RUN python -c \"from fastembed import TextEmbedding; TextEmbedding(model_name='BAAI/bge-small-en-v1.5')\""
    ]
  }
  